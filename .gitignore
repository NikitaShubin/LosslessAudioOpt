# Wine prefix (внутри проекта — симлинк на ~/.wine-llao)
.wine/

# Скачанные утилиты кодеков
bin/

# Временные файлы оптимизации и кэши
tmp/
runs/

# Накопленная статистика и служебные файлы.
# stats.jsonl — журнал, stats.tsv — итоговая таблица; они появляются рядом с
# бинарником при любом прогоне и не должны попадать в индекс.
stats.json
stats.jsonl
stats.tsv
session.json
log.log

# Рабочие/тестовые данные
files/
wav/
rzlt/
scratch_test/
scratch_rp/
2opt/

# Python
__pycache__/

# Артефакты сборки
*.o
*.d
build/
llao.exe
llao-linux
llao-daemon.exe
llao-daemon-linux
llao-*-asan

# Релизные артефакты: собираются скриптом релиза (или локально для публикации
# через gh), в git не попадают — иначе архив на ~120 МБ в истории.
llao-*-win64.zip
llao-*-win64/

# Рабочий каталог снятия golden-дампов событий
tests/golden/_dump-work/

# Тестовые артефакты
scratch_err/
test-unit
test-daemon-core
tests/wine_*

# FUSE transient files (killed daemons holding open binaries)
.fuse_hidden*

# Persist-артефакт демона, оставленный тестом при запуске из корня
queue.json
