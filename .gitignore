# Wine prefix (внутри проекта — симлинк на ~/.wine-llao)
.wine/

# Скачанные утилиты кодеков
bin/

# Временные файлы оптимизации и кэши
tmp/
runs/

# Накопленная статистика и служебные файлы
stats.json
session.json
log.log

# Рабочие/тестовые данные
files/
wav/
rzlt/
scratch_test/
2opt/

# Python
__pycache__/

# Артефакты сборки
*.o
llao.exe
llao-linux
llao-daemon.exe
llao-daemon-linux

# Тестовые артефакты
scratch_err/
test-unit
test-daemon-core
tests/wine_*

# FUSE transient files (killed daemons holding open binaries)
.fuse_hidden*
