{
  "id": "tta",
  "name": "True Audio (TTA)",
  "extension": "tta",
  "homepage": "http://tta.sourceforge.net/",
  "enabled": true,
  "engine": {
    "kind": "ffmpeg",
    "executable": "ffmpeg",
    "decoder_executable": "ffmpeg",
    "codec": "tta",
    "container": "tta"
  },
  "downloads": [
    {
      "os": "windows",
      "kind": "archive",
      "url": "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip",
      "file_glob": "**/ffmpeg.exe",
      "files": ["ffmpeg.exe", "ffprobe.exe"],
      "checksum": { "type": "sha256", "value": "" },
      "notes": "Встроенный кодер ffmpeg (-c:a tta). ffmpeg.exe из BtbN (win64-gpl), общий для ffmpeg-форматов. Альтернативный кодер ttaenc с режимом -a не используется."
    }
  ],
  "encode": {
    "cmd": ["ffmpeg", "-y", "-loglevel", "error", "-i", "{input}", "-map_metadata", "-1", "-c:a", "{codec}", "{params}", "{output}"],
    "input_format": "wav",
    "variants": [
      { "id": "default", "args": [], "note": "стандартное сжатие ffmpeg/tta" }
    ]
  },
  "decode": {
    "cmd": ["ffmpeg", "-y", "-loglevel", "error", "-i", "{input}", "{output}"],
    "output_format": "wav"
  },
  "cli_check": {
    "cmd": ["-version"],
    "expect": ["ffmpeg version"]
  },
  "verify": {
    "kind": "none",
    "cmd": []
  },
  "tag": {
    "system": "id3",
    "writer": "id3",
    "write_method": "id3v2_header",
    "native_reader": true,
    "numeric_fields": ["track", "disc"],
    "key_map": {
      "title": "TIT2", "artist": "TPE1", "album": "TALB",
      "album_artist": "TPE2", "composer": "TCOM", "genre": "TCON",
      "date": "TDRC", "track": "TRCK", "disc": "TPOS",
      "comment": "COMM", "isrc": "TSRC", "encoder": "TENC",
      "copyright": "TCOP"
    },
    "reverse_key_map": {
      "TIT2": "title", "TPE1": "artist", "TALB": "album",
      "TPE2": "album_artist", "TCOM": "composer", "TCON": "genre",
      "TDRC": "date", "TRCK": "track", "TPOS": "disc",
      "TSRC": "isrc", "TENC": "encoder", "TCOP": "copyright"
    },
    "capabilities": {
      "text": true,
      "pictures": true,
      "lyrics": true,
      "cue_sheet": false,
      "replay_gain": true,
      "chapters": false
    }
  },
  "caps": {
    "channels": { "min": 1, "max": 2 },
    "bit_depth": [8, 16, 24],
    "sample_rate": { "min": 8000, "max": 192000 }
  },
  "notes": "TTA2 — стерео 16-бит; TTA3 — до 8 каналов/24 бит. Консервативно ограничено 2 каналами и 24 бит. Теги — ID3v2 (пишутся через mutagen после кодирования)."
}
