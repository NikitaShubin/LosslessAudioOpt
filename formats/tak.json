{
 "id": "tak",
 "name": "TAK (Tom's lossless Audio Kompressor)",
 "extension": "tak",
 "homepage": "http://www.thbeck.de/Tak/Tak.html",
 "enabled": true,
 "engine": {
  "kind": "binary",
  "executable": "takc",
  "decoder_executable": "takc"
 },
 "downloads": [
  {
   "os": "windows",
   "kind": "archive",
   "url": "http://www.thbeck.de/Download/TAK_2.3.3.zip",
   "file_glob": "**/takc.exe",
   "checksum": {
    "type": "sha256",
    "value": "40d26992266f1377d576b88b84b88d2ab256dc321e47f90314402a80692aba6a"
   },
   "notes": "TAK 2.3.3 — только Windows. На Linux запускать через wine."
  }
 ],
  "encode": {
   "cmd": [
    "takc",
    "-e",
    "-overwrite",
    "-md5",
    "{params}",
    "{input}",
    "{output}"
   ],
   "input_format": "wav",
   "variants": [
    {
     "id": "p0",
     "args": [
      "-p0"
     ],
     "note": "fast"
    },
    {
     "id": "p1",
     "args": [
      "-p1"
     ],
     "note": "turbo"
    },
    {
     "id": "p2",
     "args": [
      "-p2"
     ],
     "note": "normal"
    },
    {
     "id": "p2e",
     "args": [
      "-p2e"
     ],
     "note": "нормальный + Extra evaluation"
    },
    {
     "id": "p2m",
     "args": [
      "-p2m"
     ],
     "note": "нормальный + Max evaluation"
    },
    {
     "id": "p3",
     "args": [
      "-p3"
     ],
     "note": "high"
    },
    {
     "id": "p3m",
     "args": [
      "-p3m"
     ],
     "note": "high + Max evaluation"
    },
    {
     "id": "p4",
     "args": [
      "-p4"
     ],
     "note": "max (максимальное сжатие)"
    },
    {
     "id": "p4m",
     "args": [
      "-p4m"
     ],
     "note": "max + Max evaluation (== pMax, самое сильное)"
    }
   ]
  },
 "decode": {
  "cmd": [
   "takc",
   "-d",
   "-overwrite",
   "{input}",
   "{output}"
  ],
  "output_format": "wav"
 },
 "verify": {
  "kind": "builtin",
  "cmd": [
   "takc",
   "-t",
   "{input}"
  ]
 },
 "cli_check": {
  "cmd": [
   "--help"
  ],
  "expect": [
   "takc -mode",
   "-overwrite"
  ]
 },
   "tag": {
    "system": "apev2",
    "writer": "tak",
    "write_method": "apev2_tail",
    "native_reader": true,
    "validate_skip_ffprobe": true,
    "numeric_fields": [],
    "key_map": {
      "title": "Title", "artist": "Artist", "album": "Album",
      "album_artist": "Album Artist", "composer": "Composer",
      "genre": "Genre", "date": "Year", "track": "Track",
      "disc": "Disc", "comment": "Comment", "isrc": "ISRC",
      "encoder": "Encoder", "lyrics": "Lyrics",
      "copyright": "Copyright", "cue_sheet": "Cuesheet"
    },
    "reverse_key_map": {},
    "capabilities": {
    "text": true,
    "pictures": true,
    "lyrics": true,
    "cue_sheet": true,
    "replay_gain": true,
    "chapters": false
   }
  },
 "caps": {
  "channels": {
   "min": 1,
   "max": 6
  },
  "bit_depth": [
   16,
   24
  ],
  "sample_rate": {
   "min": 1000,
   "max": 384000
  }
 },
   "notes": "TAK хранит метаданные (в т.ч. картинки и cuesheets) во встроенном контейнере; теги читаются как APEv2 (mutagen.tak). Поддерживает до 6 каналов и 24 бит. Кодирование всегда с `-md5` (MD5 исходного PCM) + встроенный CRC фреймов; `takc -t` проверяет целостность. Префикс -p# можно дополнять уровнем evaluation E/M (-p2m) вплоть до pMax — это отдельные варианты. Закрытый кодек — только Windows-утилита. Теги записываются как APEv2-хвост в конец файла (собственной реализацией LLAO): ffprobe их не показывает, поэтому валидация выполняется чтением APEv2 напрямую."
}