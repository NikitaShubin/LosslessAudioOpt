{
  "id": "mpeg4_als",
  "name": "MPEG-4 ALS",
  "extension": "m4a",
  "homepage": "https://www.nue.tu-berlin.de/menue/forschung/projekte/lossless/mp4als/",
  "enabled": false,
  "engine": {
    "kind": "ffmpeg",
    "executable": "ffmpeg",
    "decoder_executable": "ffmpeg",
    "codec": "mp4als",
    "container": "m4a"
  },
  "downloads": [
    {
      "os": "windows",
      "kind": "archive",
      "url": "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip",
      "file_glob": "**/ffmpeg.exe",
      "checksum": { "type": "sha256", "value": "" },
      "notes": "Внимание: в современных сборках ffmpeg кодер mp4als удалён (остался только декодер als). Формат фактически нерабочий, поэтому enabled=false. ffmpeg.exe общий для ffmpeg-форматов."
    }
  ],
  "encode": {
    "cmd": ["ffmpeg", "-y", "-loglevel", "error", "-i", "{input}", "-c:a", "{codec}", "{params}", "{output}"],
    "input_format": "wav",
    "variants": [
      { "id": "default", "args": ["-strict", "experimental"], "note": "экспериментальный кодер" }
    ]
  },
  "decode": {
    "cmd": ["ffmpeg", "-y", "-loglevel", "error", "-i", "{input}", "{output}"],
    "output_format": "wav"
  },
  "cli_check": {
    "cmd": ["-version"],
    "expect": ["ffmpeg version"]
  },
  "verify": {
    "kind": "none",
    "cmd": []
  },
  "tag": {
    "system": "mp4",
    "writer": "mp4",
    "write_method": "mp4_ilst",
    "native_reader": true,
    "numeric_fields": ["track", "disc"],
    "key_map": {
      "title": "\u00a9nam", "artist": "\u00a9ART", "album": "\u00a9alb",
      "album_artist": "aART", "composer": "\u00a9wrt",
      "genre": "\u00a9gen", "date": "\u00a9day",
      "comment": "\u00a9cmt", "encoder": "\u00a9too",
      "lyrics": "\u00a9lyr", "copyright": "cprt"
    },
    "reverse_key_map": {
      "\u00a9nam": "title", "\u00a9ART": "artist", "\u00a9alb": "album",
      "aART": "album_artist", "\u00a9wrt": "composer",
      "\u00a9gen": "genre", "\u00a9day": "date",
      "\u00a9cmt": "comment", "\u00a9too": "encoder",
      "\u00a9lyr": "lyrics", "cprt": "copyright"
    },
    "write_constraints": {
      "replaygain_allowed": false
    },
    "capabilities": {
      "text": true,
      "pictures": true,
      "lyrics": false,
      "cue_sheet": false,
      "replay_gain": false,
      "chapters": false
    }
  },
  "caps": {
    "channels": { "min": 1, "max": 8 },
    "bit_depth": [16, 24, 32],
    "sample_rate": { "min": 1000, "max": 192000 }
  },
  "notes": "MPEG-4 Audio Lossless Coding. Кодер в ffmpeg экспериментальный (enabled=false по умолчанию). Сжатие обычно хуже WavPack/TAK; включён для полноты перебора."
}
